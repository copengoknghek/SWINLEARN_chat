# Native local MySQL development uses localhost:3306.
DATABASE_URL="mysql://swinlearn:password@localhost:3306/swinlearn"
SESSION_SECRET="replace-with-a-long-random-development-secret"
API_PORT="3001"

# Docker Compose runs MySQL inside Docker and publishes it to this laptop port.
# Use localhost:3307 in MySQL Workbench unless you change this value.
MYSQL_HOST_PORT="3307"

# Optional: make Docker API read a native MySQL database on your laptop.
# Use this when Prisma Studio shows data from DATABASE_URL on localhost:3306
# and the Docker website should show that same data.
DOCKER_API_DATABASE_URL="mysql://swinlearn:password@host.docker.internal:3306/swinlearn"

# SWINLEARN study chatbot
GROQ_API_KEY=""
SWINLEARN_GROQ_MODEL="llama-3.1-8b-instant"
SWINLEARN_GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
SWINLEARN_GROQ_CONTEXT_CHARS="12000"
SWINLEARN_MAX_FILE_MB="20"

# Community GIF reactions (GIPHY search proxy)
GIPHY_API_KEY=""

# Community gamification (weekly badge gold cron; set false to disable)
SWINLEARN_GAMIFICATION_CRON="true"

# SWINLEARN RAG (embeddings + vector search)
GEMINI_API_KEY=""
SWINLEARN_EMBED_MODEL="gemini-embedding-001"
SWINLEARN_EMBED_DIMS="768"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
SWINLEARN_RETRIEVAL_TOP_K="8"

# Agentmemory (optional Cursor/Codex persistent memory)
# Engine:  docker compose --profile agentmemory up -d
# Worker:  scripts/start-agentmemory.cmd
# Stop:    scripts/stop-agentmemory.cmd
# MCP:     ~/.cursor/mcp.json (AGENTMEMORY_URL below)
AGENTMEMORY_URL="http://localhost:3111"
AGENTMEMORY_USE_DOCKER="0"
AGENTMEMORY_III_VERSION="0.11.2"
