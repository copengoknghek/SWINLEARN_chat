generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  teacher
  student
}

enum ProfileStatus {
  active
  inactive
}

enum Campus {
  hanoi
  danang
  hcm
}

enum CourseStatus {
  active
  archived
}

enum RegistrationRequestStatus {
  pending
  approved
  rejected
}

enum CurriculumRuleType {
  core
  elective
  major
}

enum CurriculumScope {
  global
  main_major
  child_major
}

enum CoursePrerequisiteGroupType {
  completed_credit_points
  course_alternatives
}

enum CoursePrerequisiteOptionMode {
  passed
  passed_or_concurrent
}

enum CourseStaffRole {
  teacher
  teaching_assistant
}

enum AssignmentStatus {
  draft
  published
  archived
}

enum SessionType {
  class
  lab
  event
  consultation
}

enum ConnectionStatus {
  pending
  accepted
  declined
}

enum GoldReason {
  like_received
  comment_received
  share_received
  weekly_badge
  reversal
}

enum BadgeType {
  FAN_FAVORITE
  SUPER_SUPPORTER
  GOLD_KING
  TRENDING_CREATOR
}

enum HelpRequestType {
  general
  consultation
}

enum HelpRequestStatus {
  submitted
  awaiting_teacher
  teacher_declined
  awaiting_room
  approved
  rejected
}

model User {
  id                 String                    @id @default(cuid())
  email              String                    @unique
  passwordHash       String                    @map("password_hash")
  role               UserRole
  fullName           String?                   @map("full_name")
  displayName        String?                   @map("display_name")
  avatarUrl          String?                   @map("avatar_url")
  campus             Campus?
  studentId          String?                   @unique @map("student_id")
  mustChangePassword Boolean                   @default(true) @map("must_change_password")
  status             ProfileStatus            @default(active)
  mainMajorId        String?                   @map("main_major_id")
  childMajorId       String?                   @map("child_major_id")
  goldBalance        Int                       @default(0) @map("gold_balance")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  mainMajor          MainMajor?                @relation(fields: [mainMajorId], references: [id], onDelete: SetNull)
  childMajor         ChildMajor?               @relation(fields: [childMajorId], references: [id], onDelete: SetNull)
  createdCourses     Course[]                  @relation("CourseCreator")
  createdOfferings   CourseOffering[]          @relation("OfferingCreator")
  courseStaff        CourseStaff[]
  enrollments        Enrollment[]
  registrationRequests CourseRegistrationRequest[] @relation("RegistrationRequestUser")
  decidedRegistrationRequests CourseRegistrationRequest[] @relation("RegistrationRequestDecider")
  createdAssignments Assignment[]              @relation("AssignmentCreator")
  submissions        AssignmentSubmission[]
  completedCourses   StudentCourseCompletion[] @relation("StudentCompletions")
  recordedCompletions StudentCourseCompletion[] @relation("CompletionRecorder")
  createdThreads     InboxThread[]             @relation("ThreadCreator")
  sentMessages        InboxMessage[]            @relation("MessageSender")
  inboxParticipants  InboxThreadParticipant[]
  connectionsA       Connection[]              @relation("ConnectionUserA")
  connectionsB       Connection[]              @relation("ConnectionUserB")
  sessions           UserSession[]
  managedCredentials ManagedUserCredential[]    @relation("ManagedCredentialUser")
  createdCredentials ManagedUserCredential[]    @relation("ManagedCredentialCreator")
  swinlearnThreads   SwinlearnThread[]          @relation("SwinlearnThreadStudent")
  communityPosts     CommunityPost[]            @relation("CommunityPostAuthor")
  communityComments  CommunityComment[]         @relation("CommunityCommentAuthor")
  communityPostLikes CommunityPostLike[]        @relation("CommunityPostLikeUser")
  communityCommentLikes CommunityCommentLike[]   @relation("CommunityCommentLikeUser")
  communityReadCursors CommunityReadCursor[]
  goldTransactions   GoldTransaction[]
  studentBadges      StudentBadge[]
  shareEvents        ShareEvent[]               @relation("ShareEventSharer")
  helpRequests       HelpRequest[]              @relation("HelpRequestRequester")
  consultationTeacherRequests HelpRequest[]     @relation("HelpRequestTeacher")
  decidedHelpRequests HelpRequest[]             @relation("HelpRequestDecider")
  cvProfile          UserCvProfile?

  @@index([mainMajorId])
  @@map("users")
}

model UserCvProfile {
  userId         String   @id @map("user_id")
  phone          String?
  headlineRole   String?  @map("headline_role")
  certifications String?  @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_cv_profiles")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model ManagedUserCredential {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  tempPassword String   @map("temp_password")
  createdById  String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation("ManagedCredentialUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?    @relation("ManagedCredentialCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("managed_user_credentials")
}

model MainMajor {
  id              String           @id @default(cuid())
  title           String
  summary         String           @db.Text
  sortOrder       Int              @default(0) @map("sort_order")
  teachers        User[]
  childMajors     ChildMajor[]
  curriculumRules CurriculumRule[]

  @@map("main_majors")
}

model ChildMajor {
  id              String           @id @default(cuid())
  mainMajorId     String           @map("main_major_id")
  title           String
  summary         String           @db.Text
  sortOrder       Int              @default(0) @map("sort_order")
  mainMajor       MainMajor        @relation(fields: [mainMajorId], references: [id], onDelete: Cascade)
  students        User[]
  curriculumRules CurriculumRule[]

  @@index([mainMajorId])
  @@map("child_majors")
}

model Course {
  id              String           @id @default(cuid())
  code            String           @unique
  title           String
  description     String           @db.Text
  creditPoints    Float            @default(12.5) @map("credit_points")
  createdById     String?          @map("created_by")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdBy       User?            @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  curriculumRules CurriculumRule[]
  prerequisiteGroups CoursePrerequisiteGroup[]
  requiredByOptions CoursePrerequisiteOption[] @relation("PrerequisiteRequiredCourse")
  completions      StudentCourseCompletion[]
  offerings       CourseOffering[]
  contentPackages CourseContentPackage[]

  @@map("courses")
}

model CurriculumRule {
  id           String             @id @default(cuid())
  courseId     String             @map("course_id")
  ruleType     CurriculumRuleType @map("rule_type")
  scope        CurriculumScope
  scopeKey     String             @map("scope_key")
  mainMajorId  String?            @map("main_major_id")
  childMajorId String?            @map("child_major_id")
  createdAt    DateTime           @default(now()) @map("created_at")
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mainMajor    MainMajor?         @relation(fields: [mainMajorId], references: [id], onDelete: Cascade)
  childMajor   ChildMajor?        @relation(fields: [childMajorId], references: [id], onDelete: Cascade)

  @@unique([courseId, ruleType, scope, scopeKey])
  @@index([mainMajorId])
  @@index([childMajorId])
  @@map("curriculum_rules")
}

model CoursePrerequisiteGroup {
  id                  String                       @id @default(cuid())
  courseId            String                       @map("course_id")
  requirementType     CoursePrerequisiteGroupType  @map("requirement_type")
  minimumCreditPoints Float?                       @map("minimum_credit_points")
  sortOrder           Int                          @default(0) @map("sort_order")
  createdAt           DateTime                     @default(now()) @map("created_at")
  course              Course                       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  options             CoursePrerequisiteOption[]

  @@index([courseId])
  @@map("course_prerequisite_groups")
}

model CoursePrerequisiteOption {
  id               String                         @id @default(cuid())
  groupId          String                         @map("group_id")
  requiredCourseId String                         @map("required_course_id")
  requirementMode  CoursePrerequisiteOptionMode   @map("requirement_mode")
  sortOrder        Int                            @default(0) @map("sort_order")
  createdAt        DateTime                       @default(now()) @map("created_at")
  group            CoursePrerequisiteGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requiredCourse   Course                         @relation("PrerequisiteRequiredCourse", fields: [requiredCourseId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([requiredCourseId])
  @@map("course_prerequisite_options")
}

model StudentCourseCompletion {
  id            String   @id @default(cuid())
  studentId     String   @map("student_id")
  courseId      String   @map("course_id")
  finalScore    Int      @default(50) @map("final_score")
  completedAt   DateTime @default(now()) @map("completed_at")
  createdById   String?  @map("created_by")
  student       User     @relation("StudentCompletions", fields: [studentId], references: [id], onDelete: Cascade)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy     User?    @relation("CompletionRecorder", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([createdById])
  @@map("student_course_completions")
}

model CourseOffering {
  id           String          @id @default(cuid())
  courseId     String          @map("course_id")
  term         String
  academicYear Int             @map("academic_year")
  status       CourseStatus    @default(active)
  createdById  String?         @map("created_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  course       Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation("OfferingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  staff        CourseStaff[]
  enrollments  Enrollment[]
  registrationRequests CourseRegistrationRequest[]
  assignments  Assignment[]
  sessions     CourseSession[]
  contentPackages CourseContentPackage[]
  swinlearnKnowledgeIndex SwinlearnKnowledgeIndex?
  communityPosts CommunityPost[]
  communityReadCursors CommunityReadCursor[]
  helpRequests   HelpRequest[]

  @@unique([courseId, term, academicYear])
  @@index([courseId])
  @@map("course_offerings")
}

model CourseStaff {
  id         String          @id @default(cuid())
  offeringId String          @map("offering_id")
  userId     String          @map("user_id")
  role       CourseStaffRole
  createdAt  DateTime        @default(now()) @map("created_at")
  offering   CourseOffering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offeringId, userId])
  @@index([userId])
  @@map("course_staff")
}

model Enrollment {
  id         String         @id @default(cuid())
  offeringId String         @map("offering_id")
  userId     String         @map("user_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offeringId, userId])
  @@index([userId])
  @@map("enrollments")
}

model CourseRegistrationRequest {
  id          String                    @id @default(cuid())
  offeringId  String                    @map("offering_id")
  userId      String                    @map("user_id")
  status      RegistrationRequestStatus @default(pending)
  requestedAt DateTime                  @default(now()) @map("requested_at")
  decidedAt   DateTime?                 @map("decided_at")
  decidedById String?                   @map("decided_by")
  offering    CourseOffering            @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user        User                      @relation("RegistrationRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy   User?                     @relation("RegistrationRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([offeringId, userId])
  @@index([userId])
  @@index([decidedById])
  @@map("course_registration_requests")
}

model Assignment {
  id          String                 @id @default(cuid())
  offeringId  String                 @map("offering_id")
  title       String
  description String                 @db.Text
  dueAt       DateTime               @map("due_at")
  status      AssignmentStatus       @default(published)
  createdById String?                @map("created_by")
  sourceExportId String?             @map("source_export_id")
  contentHtml String?                @db.LongText @map("content_html")
  submissionTypes String?            @db.Text @map("submission_types")
  pointsPossible Float?              @map("points_possible")
  lockAt      DateTime?              @map("lock_at")
  unlockAt    DateTime?              @map("unlock_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  offering    CourseOffering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  createdBy   User?                  @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]
  contentItems CourseContentItem[]

  @@index([offeringId])
  @@index([sourceExportId])
  @@index([offeringId, sourceExportId])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String     @map("assignment_id")
  studentId    String     @map("student_id")
  body         String     @db.Text
  filePaths    Json       @map("file_paths")
  githubUrl    String?    @map("github_url")
  indexStatus  String     @default("pending") @map("index_status")
  indexError   String?    @db.Text @map("index_error")
  indexedAt    DateTime?  @map("indexed_at")
  submittedAt  DateTime   @default(now()) @map("submitted_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

model CourseSession {
  id          String         @id @default(cuid())
  offeringId  String         @map("offering_id")
  title       String
  sessionType SessionType    @map("session_type")
  startsAt    DateTime       @map("starts_at")
  endsAt      DateTime       @map("ends_at")
  location    String
  createdById String?        @map("created_by")
  createdAt   DateTime       @default(now()) @map("created_at")
  offering    CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@map("course_sessions")
}

model CourseContentPackage {
  id                 String               @id @default(cuid())
  courseId           String?              @map("course_id")
  offeringId         String?              @map("offering_id")
  scope              String
  importId           String               @map("import_id")
  sourceTitle        String               @map("source_title")
  sourceLastDownload DateTime?            @map("source_last_download")
  originalFileName   String?              @map("original_file_name")
  language           String?
  importedById       String?              @map("imported_by")
  importedAt         DateTime             @default(now()) @map("imported_at")
  course             Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  offering           CourseOffering?      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  modules            CourseContentModule[]
  items              CourseContentItem[]
  assets             CourseContentAsset[]
  swinlearnKnowledgeIndexes SwinlearnKnowledgeIndex[]

  @@index([courseId, scope])
  @@index([offeringId, scope])
  @@map("course_content_packages")
}

model CourseContentModule {
  id             String               @id @default(cuid())
  packageId      String               @map("package_id")
  sourceId       String?              @map("source_id")
  sourceExportId String?              @map("source_export_id")
  title          String
  status         String?
  position       Int                  @default(0)
  unlockAt       DateTime?            @map("unlock_at")
  sequential     Boolean              @default(false)
  package        CourseContentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  items          CourseContentItem[]

  @@index([packageId, position])
  @@index([sourceExportId])
  @@map("course_content_modules")
}

model CourseContentItem {
  id             String               @id @default(cuid())
  packageId      String               @map("package_id")
  moduleId       String?              @map("module_id")
  assignmentId   String?              @map("assignment_id")
  assetId        String?              @map("asset_id")
  sourceId       String?              @map("source_id")
  sourceExportId String?              @map("source_export_id")
  title          String
  itemType       String               @map("item_type")
  contentHtml    String?              @db.LongText @map("content_html")
  indent         Int                  @default(0)
  position       Int                  @default(0)
  locked         Boolean              @default(false)
  completed      Boolean              @default(false)
  package        CourseContentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  module         CourseContentModule? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignment     Assignment?          @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  asset          CourseContentAsset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([packageId, position])
  @@index([moduleId, position])
  @@index([assignmentId])
  @@index([assetId])
  @@index([sourceExportId])
  @@map("course_content_items")
}

model CourseContentAsset {
  id         String               @id @default(cuid())
  packageId  String               @map("package_id")
  sourcePath String               @db.Text @map("source_path")
  title      String
  mimeType   String?              @map("mime_type")
  size       Int?
  storedPath String               @db.Text @map("stored_path")
  publicUrl  String               @db.Text @map("public_url")
  fileType   String               @map("file_type")
  package    CourseContentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  items      CourseContentItem[]

  @@index([packageId])
  @@map("course_content_assets")
}

model InboxThread {
  id           String                   @id @default(cuid())
  subject      String
  pairKey      String?                  @unique @map("pair_key")
  isGroup      Boolean                  @default(false) @map("is_group")
  color        String?
  createdById  String                   @map("created_by")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  createdBy    User                     @relation("ThreadCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants InboxThreadParticipant[]
  messages     InboxMessage[]

  @@map("inbox_threads")
}

model InboxThreadParticipant {
  id         String      @id @default(cuid())
  threadId   String      @map("thread_id")
  userId     String      @map("user_id")
  nickname   String?
  lastReadAt DateTime?   @map("last_read_at")
  hiddenAt   DateTime?   @map("hidden_at")
  createdAt  DateTime    @default(now()) @map("created_at")
  thread     InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("inbox_thread_participants")
}

model InboxMessage {
  id        String      @id @default(cuid())
  threadId  String      @map("thread_id")
  senderId  String      @map("sender_id")
  body      String      @db.Text
  gifUrl    String?     @db.Text @map("gif_url")
  createdAt DateTime    @default(now()) @map("created_at")
  thread    InboxThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User        @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
  @@map("inbox_messages")
}

model Connection {
  id            String           @id @default(cuid())
  userAId       String           @map("user_a_id")
  userBId       String           @map("user_b_id")
  requestedById String           @map("requested_by")
  status        ConnectionStatus @default(pending)
  requestedAt   DateTime         @default(now()) @map("requested_at")
  decidedAt     DateTime?        @map("decided_at")
  userA         User             @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User             @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([requestedById])
  @@map("inbox_connections")
}

model SwinlearnThread {
  id                  String                @id @default(cuid())
  studentId           String                @map("student_id")
  title               String
  pinned              Boolean               @default(false)
  selectedOfferingIds Json                  @map("selected_offering_ids")
  openaiVectorStoreId String?               @map("openai_vector_store_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  student             User                  @relation("SwinlearnThreadStudent", fields: [studentId], references: [id], onDelete: Cascade)
  messages            SwinlearnMessage[]
  attachments         SwinlearnAttachment[]

  @@index([studentId, updatedAt])
  @@map("swinlearn_threads")
}

model SwinlearnMessage {
  id                  String                @id @default(cuid())
  threadId            String                @map("thread_id")
  role                String
  content             String                @db.LongText
  citations           Json?
  metadata            Json?
  selectedOfferingIds Json                  @map("selected_offering_ids")
  model               String?
  openaiResponseId    String?               @map("openai_response_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  thread              SwinlearnThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments         SwinlearnAttachment[]

  @@index([threadId, createdAt])
  @@map("swinlearn_messages")
}

model SwinlearnAttachment {
  id                    String             @id @default(cuid())
  threadId              String             @map("thread_id")
  messageId             String?            @map("message_id")
  originalName          String             @map("original_name")
  mimeType              String?            @map("mime_type")
  size                  Int
  storedPath            String             @db.Text @map("stored_path")
  fileKind              String             @map("file_kind")
  supportedByFileSearch Boolean            @default(false) @map("supported_by_file_search")
  openaiFileId          String?            @map("openai_file_id")
  vectorStoreId         String?            @map("vector_store_id")
  createdAt             DateTime           @default(now()) @map("created_at")
  thread                SwinlearnThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message               SwinlearnMessage?  @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@index([messageId])
  @@map("swinlearn_attachments")
}

model SwinlearnKnowledgeIndex {
  id             String                @id @default(cuid())
  offeringId     String                @unique @map("offering_id")
  packageId      String?               @map("package_id")
  vectorStoreId  String?               @map("vector_store_id")
  status         String                @default("pending")
  errorMessage   String?               @db.Text @map("error_message")
  indexedAt      DateTime?             @map("indexed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  offering       CourseOffering        @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  package        CourseContentPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([packageId])
  @@map("swinlearn_knowledge_indexes")
}

model CommunityPost {
  id         String              @id @default(cuid())
  offeringId String              @map("offering_id")
  authorId   String              @map("author_id")
  body       String              @db.Text
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  offering   CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  author     User                @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments   CommunityComment[]
  likes      CommunityPostLike[]
  images     CommunityPostImage[]
  shareEvents ShareEvent[]

  @@index([offeringId, createdAt])
  @@index([authorId])
  @@map("community_posts")
}

model CommunityComment {
  id        String                 @id @default(cuid())
  postId    String                 @map("post_id")
  parentId  String?                @map("parent_id")
  authorId  String                 @map("author_id")
  body      String                 @db.Text
  gifUrl    String?                @db.Text @map("gif_url")
  createdAt DateTime               @default(now()) @map("created_at")
  post      CommunityPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    CommunityComment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[]     @relation("CommentReplies")
  author    User                   @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  images    CommunityCommentImage[]
  likes     CommunityCommentLike[]

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId])
  @@map("community_comments")
}

model CommunityPostLike {
  id        String        @id @default(cuid())
  postId    String        @map("post_id")
  userId    String        @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation("CommunityPostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@map("community_post_likes")
}

model CommunityPostImage {
  id           String        @id @default(cuid())
  postId       String        @map("post_id")
  originalName String        @map("original_name")
  mimeType     String?       @map("mime_type")
  size         Int
  storedPath   String        @db.Text @map("stored_path")
  publicUrl    String        @db.Text @map("public_url")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
  @@map("community_post_images")
}

model CommunityCommentLike {
  id        String           @id @default(cuid())
  commentId String           @map("comment_id")
  userId    String           @map("user_id")
  createdAt DateTime         @default(now()) @map("created_at")
  comment   CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User             @relation("CommunityCommentLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@map("community_comment_likes")
}

model CommunityCommentImage {
  id           String           @id @default(cuid())
  commentId    String           @map("comment_id")
  originalName String           @map("original_name")
  mimeType     String?          @map("mime_type")
  size         Int
  storedPath   String           @db.Text @map("stored_path")
  publicUrl    String           @db.Text @map("public_url")
  sortOrder    Int              @default(0) @map("sort_order")
  createdAt    DateTime         @default(now()) @map("created_at")
  comment      CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId, sortOrder])
  @@map("community_comment_images")
}

model CommunityReadCursor {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  offeringId String         @map("offering_id")
  lastReadAt DateTime       @map("last_read_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@unique([userId, offeringId])
  @@index([offeringId])
  @@map("community_read_cursors")
}

model GoldTransaction {
  id         String     @id @default(cuid())
  userId     String     @map("user_id")
  amount     Int
  reason     GoldReason
  sourceType String?    @map("source_type")
  sourceId   String?    @map("source_id")
  weekKey    String?    @map("week_key")
  createdAt  DateTime   @default(now()) @map("created_at")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@index([userId, weekKey, reason])
  @@map("gold_transactions")
}

model ShareEvent {
  id          String        @id @default(cuid())
  postId      String        @map("post_id")
  sharedById  String        @map("shared_by_id")
  recipientId String        @map("recipient_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  sharedBy    User          @relation("ShareEventSharer", fields: [sharedById], references: [id], onDelete: Cascade)

  @@unique([postId, sharedById, recipientId])
  @@index([postId])
  @@index([sharedById])
  @@map("share_events")
}

model StudentBadge {
  id      String    @id @default(cuid())
  userId  String    @map("user_id")
  type    BadgeType @unique
  since   DateTime  @default(now())
  weekKey String?   @map("week_key")
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("student_badges")
}

model Room {
  id            String        @id @default(cuid())
  name          String        @unique
  createdAt     DateTime      @default(now()) @map("created_at")
  consultations HelpRequest[] @relation("ConsultationRoom")

  @@map("rooms")
}

model HelpRequest {
  id                 String            @id @default(cuid())
  requesterId        String            @map("requester_id")
  type               HelpRequestType
  topic              String
  details            String            @db.Text
  status             HelpRequestStatus @default(submitted)
  teacherId          String?           @map("teacher_id")
  offeringId         String?           @map("offering_id")
  requestedStartsAt  DateTime?         @map("requested_starts_at")
  requestedEndsAt    DateTime?         @map("requested_ends_at")
  roomId             String?           @map("room_id")
  teacherRespondedAt DateTime?         @map("teacher_responded_at")
  decidedById        String?           @map("decided_by")
  decidedAt          DateTime?         @map("decided_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  requester          User              @relation("HelpRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  teacher            User?             @relation("HelpRequestTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  offering           CourseOffering?   @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  room               Room?             @relation("ConsultationRoom", fields: [roomId], references: [id], onDelete: SetNull)
  decidedBy          User?             @relation("HelpRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([requesterId])
  @@index([teacherId])
  @@index([status])
  @@index([roomId])
  @@map("help_requests")
}
