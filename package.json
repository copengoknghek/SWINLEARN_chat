{
  "name": "swinlearn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --build",
    "dev:logs": "docker compose logs -f api web",
    "dev:attach": "docker compose up --build",
    "dev:repair": "docker compose down --remove-orphans && docker compose up -d --build",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "dev:native:api": "node server/index.js",
    "dev:native:api:watch": "nodemon --watch server --ext js,mjs server/index.js",
    "dev:native:web": "vite",
    "docker:dev": "npm run dev",
    "docker:down": "npm run dev:down",
    "dev:down": "docker compose down",
    "agentmemory:up": "docker compose -f docker-compose.agentmemory.yml up -d agentmemory-iii-engine",
    "agentmemory:down": "docker compose -f docker-compose.agentmemory.yml down",
    "agentmemory:logs": "docker compose -f docker-compose.agentmemory.yml logs -f agentmemory-iii-engine",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:seed:rooms": "node prisma/seed-rooms-only.js",
    "prisma:clear-demo": "node prisma/clear-demo-data.js",
    "test": "node --test server/services/*.test.mjs",
    "test:nlu": "RUN_LIVE_NLU=1 node --test server/services/nluEval.live.test.mjs"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@prisma/client": "6.19.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "node-cron": "^4.5.0",
    "officeparser": "^5.2.2",
    "pdfkit": "^0.15.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "prisma": "6.19.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
